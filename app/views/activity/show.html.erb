<% content_for :title, t("game.activity.title") %>

<section class="nl-quests" data-activity-board="1">
  <header class="nl-quests__header">
    <h1><%= t("game.activity.title") %></h1>
    <p><%= t("game.activity.hint") %></p>
  </header>

  <h2 class="nl-quests__giver"><%= t("game.activity.daily_title") %></h2>
  <div class="nl-quests__list">
    <% @contracts.each do |row| %>
      <% ready = row.completed_at.present? && row.claimed_at.blank? %>
      <article class="nl-quests__card nl-quests__card--<%= ready ? "ready" : (row.claimed_at ? "completed" : "active") %>"
               data-contract-key="<%= row.contract_key %>">
        <div class="nl-quests__card-top">
          <h2><%= t("game.activity.contract.#{row.contract_key}", default: row.contract_key) %></h2>
          <span class="nl-quests__badge"><%= row.progress %> / <%= row.target %></span>
        </div>
        <% if ready %>
          <%= button_to t("game.activity.claim"),
                claim_activity_path(kind: "contract", id: row.id),
                method: :post,
                class: "nl-arena-small-button" %>
        <% elsif row.claimed_at.present? %>
          <p class="nl-quests-board__meta"><%= t("game.activity.claimed_label") %></p>
        <% end %>
      </article>
    <% end %>
  </div>

  <h2 class="nl-quests__giver"><%= t("game.activity.achievements_title") %></h2>
  <div class="nl-quests__list">
    <% if @achievements.empty? %>
      <p class="nl-quests-board__meta"><%= t("game.activity.achievements_empty") %></p>
    <% else %>
      <% @achievements.each do |row| %>
        <% ready = row.completed_at.present? && row.claimed_at.blank? %>
        <% title = I18n.locale.to_s.start_with?("ru") ? row.metadata["name_ru"] : row.metadata["name_en"] %>
        <article class="nl-quests__card" data-achievement-key="<%= row.achievement_key %>">
          <div class="nl-quests__card-top">
            <h2><%= title.presence || row.achievement_key %></h2>
            <span class="nl-quests__badge"><%= row.progress %> / <%= row.required %></span>
          </div>
          <% if ready %>
            <%= button_to t("game.activity.claim"),
                  claim_activity_path(kind: "achievement", id: row.id),
                  method: :post,
                  class: "nl-arena-small-button" %>
          <% end %>
        </article>
      <% end %>
    <% end %>
  </div>
</section>
