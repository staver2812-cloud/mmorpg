<% content_for :title, t("game.activity.title") %>

<section class="nl-quests" data-activity-board="1">
  <header class="nl-quests__header">
    <h1><%= t("game.activity.title") %></h1>
    <p><%= t("game.activity.hint") %></p>
    <p class="nl-quests-board__meta">
      <%= link_to t("nav.return"), world_path, class: "nl-sheet-link", data: {turbo_frame: "_top"} %>
    </p>
  </header>

  <%= render "shared/first_hour_rail" %>

  <h2><%= t("game.activity.daily_title") %></h2>
  <% if Game::Seasons::Catalog.active? %>
    <% season_snap = Game::Seasons::Progress.new(character: current_character).snapshot %>
    <p class="nl-quests-board__meta" data-season-fomo="1">
      <%= t("game.season.countdown", days: season_snap[:days_left], xp: season_snap[:xp]) %>
      · <%= link_to t("game.season.nav"), season_path, class: "nl-sheet-link", data: {turbo_frame: "_top"} %>
    </p>
  <% end %>
  <% if @claim_streak.to_i.positive? %>
    <p class="nl-quests-board__meta" data-claim-streak="<%= @claim_streak %>">
      <%= t("game.activity.streak_label", count: @claim_streak) %>
    </p>
  <% end %>
  <div class="nl-quests__list">
    <% @contracts.each do |row| %>
      <% ready = row.completed_at.present? && row.claimed_at.blank? %>
      <% pct = row.target.to_i.positive? ? ((row.progress.to_f / row.target) * 100).round : 0 %>
      <article class="nl-quests__card nl-quests__card--<%= ready ? "ready" : (row.claimed_at ? "completed" : "active") %>"
               data-contract-key="<%= row.contract_key %>"
               data-progress="<%= pct %>">
        <div class="nl-quests__card-top">
          <h2><%= t("game.activity.contract.#{row.contract_key}", default: row.contract_key) %></h2>
          <span class="nl-quests__badge"><%= row.progress %> / <%= row.target %></span>
        </div>
        <div class="nl-progress" role="progressbar" aria-valuemin="0" aria-valuemax="<%= row.target %>" aria-valuenow="<%= row.progress %>">
          <span class="nl-progress__fill<%= " nl-progress__fill--ready" if ready %>" style="width: <%= pct %>%"></span>
        </div>
        <% if ready %>
          <%= button_to t("game.activity.claim"),
                claim_activity_path(kind: "contract", id: row.id),
                method: :post,
                class: "nl-arena-small-button nl-claim-pulse" %>
        <% elsif row.claimed_at.present? %>
          <p class="nl-quests-board__meta"><%= t("game.activity.claimed_label") %></p>
        <% end %>
      </article>
    <% end %>
  </div>

  <h2 class="nl-quests__giver"><%= t("game.activity.achievements_title") %></h2>
  <%
    tier_filter = params[:tier].to_s.presence
    tiers = %w[combat special consumer peaceful legendary]
  %>
  <nav class="nl-activity-tiers" aria-label="<%= t("game.activity.achievements_title") %>" data-activity-tiers="1">
    <%= link_to t("game.activity.tier_all", default: "Все"),
          activity_path,
          class: "lbut#{' lbut--active' if tier_filter.blank?}",
          data: {activity_tier: "all"} %>
    <% tiers.each do |tier| %>
      <%= link_to t("game.activity.tier_#{tier}", default: tier),
            activity_path(tier:),
            class: "lbut#{' lbut--active' if tier_filter == tier}",
            data: {activity_tier: tier} %>
    <% end %>
  </nav>
  <div class="nl-quests__list nl-activity-grid">
    <% if @achievements.empty? %>
      <p class="nl-quests-board__meta"><%= t("game.activity.achievements_empty") %></p>
    <% else %>
      <%
        by_chain = @achievements.group_by { |row| row.metadata.to_h["id"].presence || row.achievement_key.to_s.split(":").first }
      %>
      <% by_chain.each do |_chain_id, rows| %>
        <% rows.sort_by { |r| r.metadata.to_h["step"].to_i }.each do |row| %>
          <% step = row.metadata.to_h["step"].to_i %>
          <% prior = rows.find { |r| r.metadata.to_h["step"].to_i == step - 1 } if step.positive? %>
          <% unlocked = step.zero? || prior&.completed_at.present? %>
          <% next unless unlocked || row.progress.to_i.positive? || row.completed_at.present? %>
          <% ready = row.completed_at.present? && row.claimed_at.blank? %>
          <% title = I18n.locale.to_s.start_with?("ru") ? row.metadata["name_ru"] : row.metadata["name_en"] %>
          <% tier = row.metadata.to_h["tier"].to_s %>
          <% next if tier_filter.present? && tier != tier_filter %>
          <article class="nl-quests__card nl-quests__card--<%= ready ? "ready" : (row.claimed_at ? "completed" : (unlocked ? "active" : "locked")) %>"
                   data-achievement-key="<%= row.achievement_key %>"
                   data-achievement-tier="<%= tier %>">
            <div class="nl-quests__card-top">
              <h2><%= title.presence || row.achievement_key %></h2>
              <span class="nl-quests__badge"><%= row.progress %> / <%= row.required %></span>
            </div>
            <% if tier.present? %>
              <p class="nl-quests-board__meta"><%= t("game.activity.tier_#{tier}", default: tier) %></p>
            <% end %>
            <% remaining = [row.required.to_i - row.progress.to_i, 0].max %>
            <% if remaining.positive? && row.completed_at.blank? %>
              <p class="nl-quests-board__meta"><%= t("game.activity.remaining", default: "Осталось: %{count}", count: remaining) %></p>
            <% end %>
            <% if ready %>
              <%= button_to t("game.activity.claim"),
                    claim_activity_path(kind: "achievement", id: row.id),
                    method: :post,
                    class: "nl-arena-small-button" %>
            <% elsif row.claimed_at.present? %>
              <p class="nl-quests-board__meta"><%= t("game.activity.claimed_label") %></p>
            <% elsif !unlocked %>
              <p class="nl-quests-board__meta"><%= t("game.activity.tier_locked") %></p>
            <% end %>
          </article>
        <% end %>
      <% end %>
    <% end %>
  </div>
</section>
