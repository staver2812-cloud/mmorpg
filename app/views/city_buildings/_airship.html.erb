<div class="nl-airship-station">
  <table class="nl-airship-routes">
    <thead><tr><th><%= t("game.common.route") %></th><th><%= t("game.common.price") %></th><th><%= t("game.common.next_departure") %></th><th></th></tr></thead>
    <tbody>
      <% routes.each do |route| %>
        <tr data-airship-route="<%= route.key %>">
          <td><%= route.label %></td>
          <td><%= number_with_precision(route.fare_nv, precision: 2) %> NV</td>
          <td><%= route.departs_at ? l(route.departs_at, format: "%Y-%m-%d %H:%M:%S") : t("game.common.unavailable") %></td>
          <td>
            <% if route.available %>
              <%= button_to t("game.airship.board"), airship_path,
                  method: :post, params: {action_key: route.action_key}, class: "lbut",
                  form: {data: {turbo_frame: "_top"}} %>
            <% else %>
              <button type="button" class="lbut" disabled><%= t("game.common.unavailable") %></button>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
