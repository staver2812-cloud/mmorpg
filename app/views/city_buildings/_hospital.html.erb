<div class="nl-city-building-tabs">
  <% building["tabs"].each do |tab| %>
    <span class="nl-city-building-tab"><%= tab %></span>
  <% end %>
</div>

<section class="nl-handbook" aria-label="<%= t("game.buildings.hospital_rest_aria") %>">
  <% hp = current_character.current_hp.to_i %>
  <% max_hp = current_character.effective_max_hp.to_i %>
  <% mp = current_character.current_mp.to_i %>
  <% max_mp = current_character.effective_max_mp.to_i %>
  <% injuries = Game::Combat::InjuryState.new(character: current_character) %>
  <% ordinary = injuries.active.any? { |row| %w[light heavy].include?(row["severity"].to_s) } %>
  <% combat_left = injuries.active.any? { |row| row["severity"].to_s == "combat" } %>
  <% needs_rest = hp < max_hp || mp < max_mp || ordinary %>
  <% injury_summary = injuries.summary %>
  <h2><%= t("game.buildings.hospital_hint") %></h2>
  <p><%= t("game.buildings.hospital_rest_lead") %></p>
  <p class="nl-quests-board__meta"><%= t("game.buildings.hospital_combat_rule") %></p>
  <p class="nl-quests-board__meta" data-hospital-vitals="1" data-hospital-rest-ready="<%= needs_rest ? "1" : "0" %>" data-hospital-combat="<%= combat_left ? "1" : "0" %>">
    <%= t("game.buildings.hospital_vitals", hp: hp, max_hp: max_hp, mp: mp, max_mp: max_mp) %>
  </p>
  <% if injury_summary.present? %>
    <p class="nl-quests-board__meta" data-hospital-injuries="<%= injuries.active.size %>"><%= injury_summary %></p>
  <% else %>
    <p class="nl-quests-board__meta" data-hospital-injuries="0"><%= t("game.buildings.hospital_no_injuries") %></p>
  <% end %>
  <p>
    <% if needs_rest %>
      <%= button_to t("game.buildings.hospital_rest_cta"),
            city_building_rest_path("hospital"),
            method: :post,
            class: "lbut",
            form: {data: {turbo: false}} %>
    <% else %>
      <% blocked = combat_left ? t("game.buildings.hospital_combat_only") : t("game.buildings.hospital_already_full") %>
      <button type="button" class="lbut" disabled title="<%= blocked %>"><%= t("game.buildings.hospital_rest_cta") %></button>
      <span class="nl-quests-board__meta"><%= blocked %></span>
    <% end %>
  </p>
</section>

<section class="nl-handbook" aria-label="<%= t("game.professions.ash_healer") %>">
  <h2><%= t("game.professions.ash_healer") %></h2>
  <p class="nl-handbook__lead">
    <%= t("game.professions.ash_healer_lead", skill: local_assigns.fetch(:skill, 0)) %>
  </p>
  <% inv = current_character.inventory %>
  <% bag_weight = inv&.current_weight.to_i || 0 %>
  <% bag_max = inv&.max_weight.to_i || current_character.carrying_capacity.to_i %>
  <% bag_slots = inv&.inventory_items&.where(equipped: false)&.count.to_i || 0 %>
  <% bag_slot_cap = inv&.slot_capacity.to_i || 0 %>
  <p class="nl-quests-board__meta"
     data-hospital-mass="<%= bag_weight %>"
     data-hospital-mass-max="<%= bag_max %>"
     data-hospital-slots="<%= bag_slots %>"
     data-hospital-slots-max="<%= bag_slot_cap %>">
    <%= t("game.professions.bag_capacity", weight: bag_weight, max: bag_max, slots: bag_slots, slot_max: bag_slot_cap) %>
  </p>
  <div class="nl-handbook__grid">
    <% local_assigns.fetch(:recipes, {}).each do |key, recipe| %>
      <% title = I18n.locale.to_s.start_with?("ru") ? recipe["title_ru"] : recipe["title_en"] %>
      <% summary = I18n.locale.to_s.start_with?("ru") ? recipe["summary_ru"] : recipe["summary_en"] %>
      <% gate = craft_readiness(recipe, character: current_character, skill: local_assigns.fetch(:skill, 0)) %>
      <article class="nl-handbook__card">
        <h3><%= title %></h3>
        <p><%= summary %></p>
        <p class="nl-quests-board__meta">
          <%= t("game.professions.min_skill", amount: recipe.fetch("min_skill", 0)) %>
          ·
          <%= t("game.professions.inputs") %>:
          <%= craft_input_labels(recipe, character: current_character) %>
        </p>
        <% if gate[:ready] %>
          <%= button_to t("game.professions.craft_cta"),
                city_building_craft_path("hospital"),
                method: :post,
                params: {recipe_key: key},
                class: "lbut",
                form: {data: {turbo: false}} %>
        <% else %>
          <button type="button" class="lbut" disabled title="<%= gate[:reason] %>"><%= t("game.professions.craft_cta") %></button>
          <p class="nl-quests-board__meta"><%= gate[:reason] %></p>
        <% end %>
      </article>
    <% end %>
  </div>
</section>

<section class="nl-handbook" aria-label="<%= t("game.buildings.premium_desk") %>">
  <h2><%= t("game.buildings.premium_desk") %></h2>
  <% marks = local_assigns.fetch(:veil_marks, 0).to_i %>
  <p data-hospital-vm="<%= marks %>"><%= t("game.buildings.premium_lead", marks: marks) %></p>
  <% assault_owned = Game::World::StartPlayerAssault.trauma_scroll_quantity(current_character) %>
  <% heal_owned = Game::Shop::PremiumScrollPurchase.owned_quantity(current_character, "combat_heal_scroll") %>
  <p class="nl-quests-board__meta"
     data-hospital-assault="<%= assault_owned %>"
     data-hospital-heal="<%= heal_owned %>">
    <%= t("game.world.trauma_scroll_chip", count: assault_owned) %>
    ·
    <%= t("game.world.heal_scroll_chip", count: heal_owned) %>
  </p>
  <p>
    <%= button_to t("game.buildings.premium_topup_cta", amount: Game::Shop::VeilMarksTopUp::AMOUNT),
          city_building_topup_vm_path("hospital"),
          method: :post,
          class: "lbut",
          form: {data: {turbo: false}},
          title: t("game.buildings.premium_topup_hint") %>
  </p>
  <div class="nl-handbook__grid">
    <% local_assigns.fetch(:premium_offers, {}).each do |item_key, price| %>
      <% owned = current_character.inventory&.inventory_items
           &.joins(:item_template)
           &.where(item_templates: {key: item_key}, equipped: false)
           &.sum(:quantity).to_i || 0 %>
      <% price_i = price.to_i %>
      <% affordable = marks >= price_i %>
      <article class="nl-handbook__card" data-hospital-premium-affordable="<%= affordable ? "1" : "0" %>">
        <h3><%= t("game.buildings.premium_item.#{item_key}", default: item_key) %></h3>
        <p><%= t("game.buildings.premium_item_hint.#{item_key}", default: "") %></p>
        <p class="nl-quests-board__meta">
          <%= price_i %> VM
          ·
          <%= t("game.buildings.premium_owned", count: owned) %>
        </p>
        <% if affordable %>
          <%= button_to t("game.buildings.premium_buy_cta", amount: price_i),
                city_building_buy_premium_path("hospital"),
                method: :post,
                params: {item_key: item_key},
                class: "lbut",
                form: {data: {turbo: false}} %>
        <% else %>
          <% short = t("game.buildings.premium_short", amount: price_i) %>
          <button type="button" class="lbut" disabled title="<%= short %>"><%= t("game.buildings.premium_buy_cta", amount: price_i) %></button>
          <p class="nl-quests-board__meta"><%= short %></p>
        <% end %>
      </article>
    <% end %>
  </div>
</section>
