<div class="nl-city-building-tabs">
  <% building["tabs"].each do |tab| %>
    <span class="nl-city-building-tab"><%= tab %></span>
  <% end %>
</div>

<h2><%= t("game.buildings.hospital_title") %></h2>
<table class="nl-detail-table nl-city-building-table">
  <thead><tr><th><%= t("game.common.item") %></th><th><%= t("game.common.resource") %></th><th><%= t("game.common.price") %></th><th><%= t("game.common.observed_stock") %></th></tr></thead>
  <tbody>
    <% building["goods"].each do |name, resource, price, stock| %>
      <tr><td><%= name %></td><td><%= resource %></td><td><%= number_with_delimiter(price) %> NV</td><td><%= stock %></td></tr>
    <% end %>
  </tbody>
</table>

<section class="nl-handbook" aria-label="<%= t("game.buildings.hospital_rest_aria") %>">
  <h2><%= t("game.buildings.hospital_hint") %></h2>
  <p><%= t("game.buildings.hospital_rest_lead") %></p>
  <p>
    <%= button_to t("game.buildings.hospital_rest_cta"),
          city_building_rest_path("hospital"),
          method: :post,
          class: "lbut",
          form: {data: {turbo: false}} %>
  </p>
</section>
