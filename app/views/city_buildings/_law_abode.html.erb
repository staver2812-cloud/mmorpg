<% cost = Game::World::LawAlignmentPledge::CHANGE_COST.to_d %>
<% wallet = current_user.currency_wallet || current_user.create_currency_wallet!(nv_balance: 0) %>
<% balance = wallet.nv_balance.to_d %>
<% first_pledge = current_character.alignment.to_s == "none" %>
<section class="nl-handbook" aria-label="<%= t("game.buildings.law_aria") %>"
         data-law-alignment="<%= current_character.alignment %>"
         data-law-wallet="<%= balance.to_i %>"
         data-law-first-pledge="<%= first_pledge ? "1" : "0" %>">
  <h2><%= t("game.buildings.law_title") %></h2>
  <p class="nl-handbook__lead">
    <%= t(
          "game.buildings.law_lead",
          current: t("game.buildings.law_alignment.#{current_character.alignment}"),
          amount: Game::World::LawAlignmentPledge::CHANGE_COST
        ) %>
  </p>
  <p class="nl-quests-board__meta"><%= t("game.buildings.law_wallet", amount: balance.to_i) %></p>
  <p class="nl-quests-board__meta" data-law-pledge-mode="<%= first_pledge ? "free" : "paid" %>">
    <%= first_pledge ? t("game.buildings.law_first_free") : t("game.buildings.law_change_cost", amount: Game::World::LawAlignmentPledge::CHANGE_COST) %>
  </p>
  <p class="nl-quests-board__meta"><%= t("game.buildings.law_quarter_east_gate") %></p>
  <div class="nl-handbook__grid">
    <% Game::World::LawAlignmentPledge::CHOICES.each do |key| %>
      <article class="nl-handbook__card" data-law-choice="<%= key %>">
        <h3><%= t("game.buildings.law_alignment.#{key}") %></h3>
        <p><%= t("game.buildings.law_alignment_hint.#{key}") %></p>
        <% if current_character.alignment == key %>
          <button type="button" class="lbut" disabled><%= t("game.buildings.law_current_cta") %></button>
        <% elsif first_pledge %>
          <%= button_to t("game.buildings.law_pledge_cta"),
                city_building_law_path("law_abode"),
                method: :post,
                params: {alignment: key},
                class: "lbut",
                form: {data: {turbo: false}} %>
        <% elsif balance >= cost %>
          <%= button_to t("game.buildings.law_change_cta", amount: Game::World::LawAlignmentPledge::CHANGE_COST),
                city_building_law_path("law_abode"),
                method: :post,
                params: {alignment: key},
                class: "lbut",
                form: {data: {turbo: false}} %>
        <% else %>
          <button type="button" class="lbut" disabled title="<%= t("game.buildings.law_need_nv", amount: Game::World::LawAlignmentPledge::CHANGE_COST) %>"><%= t("game.buildings.law_need_nv_short") %></button>
          <p class="nl-quests-board__meta"><%= t("game.buildings.law_need_nv", amount: Game::World::LawAlignmentPledge::CHANGE_COST) %></p>
        <% end %>
      </article>
    <% end %>
  </div>
</section>
