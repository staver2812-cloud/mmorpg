<section class="nl-handbook">
  <h2><%= building["title"] %></h2>
  <% case local_assigns[:building_key].to_s %>
  <% when "prison" %>
    <p class="nl-handbook__lead"><%= t("game.buildings.prison_lead") %></p>
    <p><%= link_to t("game.buildings.law_open_cta"), city_building_path("law_abode"), class: "lbut" %></p>
  <% when "gallows" %>
    <p class="nl-handbook__lead"><%= t("game.buildings.gallows_lead") %></p>
    <p><%= link_to t("game.buildings.law_open_cta"), city_building_path("law_abode"), class: "lbut" %></p>
  <% else %>
    <p class="nl-handbook__lead">
      Интерьер открыт для осмотра. Игровые действия — отдельным срезом.
      Выход: кнопка «<%= t("arena.nav.city") %>» в шапке — без тупика.
    </p>
  <% end %>
</section>
