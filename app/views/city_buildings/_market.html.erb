<%= render "shop/merchant_qualification", location: :market %>

<p class="nl-city-building-notice">
  <%= link_to t("game.shop.title"), shop_path, class: "lbut" %>
  <%= link_to t("game.buildings.junk_dealer_link"), city_building_path("junk_dealer"), class: "lbut" %>
</p>

<h2><%= t("game.buildings.stall_tiers") %></h2>
<table class="nl-detail-table nl-city-building-table">
  <thead>
    <tr><th><%= t("game.common.stall") %></th><th><%= t("game.common.merchant_skill") %></th><th><%= t("game.common.mass") %></th><th>30-day rent</th><th><%= t("game.common.sale_tax") %></th></tr>
  </thead>
  <tbody>
    <% building["stall_tiers"].each do |name, skill, mass, rent, tax| %>
      <tr><td><%= name %></td><td><%= skill %></td><td><%= mass %></td><td><%= number_with_delimiter(rent) %> NV</td><td><%= tax %></td></tr>
    <% end %>
  </tbody>
</table>
