<section class="nl-handbook" aria-label="<%= t("game.buildings.souvenir_aria") %>">
  <h2><%= t("game.buildings.souvenir_title") %></h2>
  <p class="nl-handbook__lead"><%= t("game.buildings.souvenir_lead") %></p>
  <% wallet = current_user.currency_wallet || current_user.create_currency_wallet!(nv_balance: 0) %>
  <% balance = wallet.nv_balance.to_d %>
  <p class="nl-quests-board__meta" data-souvenir-wallet="<%= balance.to_i %>">
    <%= t("game.buildings.souvenir_wallet", amount: balance.to_i) %>
  </p>
  <div class="nl-handbook__grid">
    <% Game::World::SouvenirPurchase::OFFERINGS.each do |item_key, price| %>
      <% template = ItemTemplate.find_by(key: item_key) %>
      <% owned = template ? current_character.inventory&.inventory_items&.where(item_template: template, equipped: false)&.sum(:quantity).to_i : 0 %>
      <% affordable = balance >= price.to_d %>
      <article class="nl-handbook__card"
               data-souvenir-item="<%= item_key %>"
               data-souvenir-affordable="<%= affordable ? "1" : "0" %>">
        <h3><%= template&.display_name || item_key %></h3>
        <p class="nl-quests-board__meta">
          <%= price %> NV
          · <%= t("game.buildings.souvenir_owned", count: owned) %>
        </p>
        <% if affordable %>
          <%= button_to t("game.buildings.souvenir_buy_cta", amount: price),
                city_building_souvenir_path("souvenir_shop"),
                method: :post,
                params: {item_key: item_key},
                class: "lbut",
                form: {data: {turbo: false}} %>
        <% else %>
          <button type="button" class="lbut" disabled title="<%= t("game.buildings.souvenir_need_nv", amount: price) %>"><%= t("game.buildings.souvenir_need_nv_short") %></button>
          <p class="nl-quests-board__meta"><%= t("game.buildings.souvenir_need_nv", amount: price) %></p>
        <% end %>
      </article>
    <% end %>
  </div>
</section>

<%= render "city_buildings/landmark", building: building, building_key: "souvenir_shop" %>
