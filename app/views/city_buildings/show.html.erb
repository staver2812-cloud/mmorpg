<% if @building["kind"] == "airship" %>
  <div class="nl-airship-station-page" data-building-key="<%= @building_key %>">
    <header class="nl-city-building-header">
      <div>
        <h1><%= @building["title"] %></h1>
        <p><%= @building["summary"] %></p>
      </div>
      <%= link_to t("arena.nav.city"), world_path, class: "lbut", data: {turbo: false} %>
    </header>
    <%= render "city_buildings/airship", routes: @airship_routes %>
  </div>
<% else %>
<div class="nl-city-building-page" data-building-key="<%= @building_key %>">
    <section class="nl-city-building-frame">
      <header class="nl-city-building-header">
        <div>
          <h1><%= @building["title"] %></h1>
          <p><%= @building["summary"] %></p>
        </div>
        <%= link_to t("arena.nav.city"), world_path, class: "lbut", data: {turbo: false} %>
      </header>

      <p class="nl-city-building-notice">
        <% if @building["kind"] == "market" %>
          Аренда прилавков и лоты игроков пока только для просмотра.
        <% elsif @building["kind"] == "workshop" %>
          <%= t("game.professions.workshop_notice") %>
        <% elsif @building["kind"] == "junk_buyback" %>
          <%= t("game.buildings.junk_lead") %>
        <% elsif @building["kind"] == "obelisk" %>
          <%= t("game.buildings.obelisk_lead", amount: Game::World::ObeliskRecall::RECALL_COST) %>
        <% elsif @building["kind"] == "souvenir" %>
          <%= t("game.buildings.souvenir_lead") %>
        <% elsif @building["kind"] == "post" %>
          <%= t("game.buildings.post_lead") %>
        <% elsif @building["kind"] == "bank" %>
          <%= t("game.buildings.bank_lead", wallet: @bank_wallet_nv, vault: @bank_vault_nv) %>
        <% elsif @building["kind"] == "temple" %>
          <%= t("game.buildings.temple_rite_lead", amount: Game::World::TempleBlessing::COST_NV) %>
        <% elsif @building["kind"] == "tavern" %>
          <%= t("game.buildings.tavern_rest_lead") %>
        <% elsif @building["kind"] == "landmark" %>
          Интерьер открыт. Игровые действия здания появятся в следующих срезах.
        <% elsif @building["kind"] == "hospital" %>
          <%= t("game.buildings.hospital_rest_lead") %>
          <% if @injury_summary.present? %>
            <br><strong><%= @injury_summary %></strong>
          <% end %>
        <% else %>
          Поверхность пока read-only: без покупки, продажи, лечения и аренды.
        <% end %>
      </p>

      <% case @building["kind"] %>
      <% when "market" %>
        <%= render "city_buildings/market", building: @building %>
      <% when "shop_shell" %>
        <%= render "city_buildings/shop_shell", building: @building %>
      <% when "junk_buyback" %>
        <%= render "city_buildings/junk_buyback", offers: @junk_offers %>
      <% when "numismatics" %>
        <%= render "city_buildings/numismatics", building: @building %>
      <% when "hospital" %>
        <%= render "city_buildings/hospital",
              building: @building,
              recipes: @profession_recipes,
              skill: @ash_healer_skill,
              veil_marks: @veil_marks,
              premium_offers: @premium_offers %>
      <% when "workshop" %>
        <%= render "city_buildings/workshop", recipes: @profession_recipes, skill: @tar_smith_skill %>
      <% when "tavern" %>
        <%= render "city_buildings/tavern", building: @building %>
      <% when "temple" %>
        <%= render "city_buildings/temple", building: @building %>
      <% when "bank" %>
        <%= render "city_buildings/bank",
              building: @building,
              wallet_nv: @bank_wallet_nv,
              vault_nv: @bank_vault_nv %>
      <% when "post" %>
        <%= render "city_buildings/post", building: @building, note: @post_note %>
      <% when "souvenir" %>
        <%= render "city_buildings/souvenir_shop", building: @building %>
      <% when "obelisk" %>
        <%= render "city_buildings/obelisk", building: @building, bound: @obelisk_bound %>
      <% when "landmark" %>
        <%= render "city_buildings/landmark", building: @building, building_key: @building_key %>
      <% end %>

      <% if @building_key == "city_hall" %>
        <% quest_journal = Game::Quests::Journal.new(character: current_character) %>
        <% quest_entries = quest_journal.entries %>
        <% quest_counts = quest_entries.group_by { |e| e[:status] }.transform_values(&:size) %>
        <section class="nl-quests-board">
          <h2><%= t("game.quests.board_title") %></h2>
          <p><%= t("game.quests.hint") %></p>
          <% if (chip = quest_journal.active_chip).present? %>
            <p class="nl-quests-board__active"><%= link_to chip, quests_path %></p>
          <% end %>
          <ul class="nl-quests__summary" aria-label="<%= t("game.quests.summary_aria") %>">
            <li><span><%= t("game.quests.status.active") %></span> <b><%= quest_counts.fetch("active", 0) %></b></li>
            <li><span><%= t("game.quests.status.available") %></span> <b><%= quest_counts.fetch("available", 0) %></b></li>
            <li><span><%= t("game.quests.status.locked") %></span> <b><%= quest_counts.fetch("locked", 0) %></b></li>
            <li><span><%= t("game.quests.status.completed") %></span> <b><%= quest_counts.fetch("completed", 0) %></b></li>
          </ul>
          <%= link_to t("game.quests.board_open"), quests_path, class: "lbut" %>
          <p class="nl-quests-board__meta"><%= t("game.quests.board_meta") %></p>
        </section>
      <% end %>
    </section>
</div>
<% end %>
