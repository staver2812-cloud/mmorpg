<% if @building["kind"] == "airship" %>
  <div class="nl-airship-station-page" data-building-key="<%= @building_key %>">
    <h1 class="nl-visually-hidden"><%= @building["title"] %></h1>
    <%= render "city_buildings/airship", routes: @airship_routes %>
  </div>
<% else %>
<div class="nl-city-building-page" data-building-key="<%= @building_key %>">
    <section class="nl-city-building-frame">
      <header class="nl-city-building-header">
        <div>
          <h1><%= @building["title"] %></h1>
          <p><%= @building["summary"] %></p>
        </div>
        <%= link_to t("arena.nav.city"), world_path, class: "lbut", data: {turbo: false} %>
      </header>

      <p class="nl-city-building-notice">
        <% if @building["kind"] == "market" %>
          Аренда прилавков и лоты игроков пока только для просмотра.
        <% elsif @building["kind"] == "landmark" %>
          Интерьер открыт. Игровые действия здания появятся в следующих срезах.
        <% else %>
          Поверхность пока read-only: без покупки, продажи, лечения и аренды.
        <% end %>
      </p>

      <% case @building["kind"] %>
      <% when "market" %>
        <%= render "city_buildings/market", building: @building %>
      <% when "shop_shell" %>
        <%= render "city_buildings/shop_shell", building: @building %>
      <% when "numismatics" %>
        <%= render "city_buildings/numismatics", building: @building %>
      <% when "hospital" %>
        <%= render "city_buildings/hospital", building: @building %>
      <% when "landmark" %>
        <%= render "city_buildings/landmark", building: @building, building_key: @building_key %>
      <% end %>

      <% if @building_key == "city_hall" %>
        <section class="nl-quests-board">
          <h2><%= t("game.quests.board_title") %></h2>
          <p><%= t("game.quests.hint") %></p>
          <%= link_to t("game.quests.board_open"), quests_path, class: "lbut" %>
          <p class="nl-quests-board__meta"><%= t("game.quests.board_meta") %></p>
        </section>
      <% end %>
    </section>
</div>
<% end %>
