<div class="nl-family-inventory">
  <% inventory_family_sections(category).each do |title, empty_message, discardable| %>
    <section class="nl-family-inventory-section">
      <header>
        <h3><%= title %></h3>
        <% if discardable %>
          <%= form_with url: inventory_path, method: :get, class: "nl-inline-action-form" do |f| %>
            <%= f.hidden_field :category, value: category %>
            <%= f.select :subact, [[t("game.inventory.choose_action"), "0"], [t("game.inventory.discard_action"), "discard"]], {}, class: "LogintextBox" %>
            <%= f.submit t("game.common.ok"), class: "weaponch", data: {turbo_confirm: t("game.inventory.discard_resources_confirm", title: title)} %>
          <% end %>
        <% end %>
      </header>
      <p class="nl-empty-note"><%= empty_message %></p>
    </section>
  <% end %>
</div>
