<% content_for :title, "#{t('manage.views.audit_title')} · #{t('manage.title')}" %>
<%= render "manage/shared/page_header", title: t("manage.views.audit_title"), description: t("manage.views.audit_hint") %>
<%= form_with url: manage_audit_events_path, method: :get, class: "nl-manage-filter", local: true do |form| %>
  <%= form.label :record_type %><%= form.select :record_type, @record_types, include_blank: t("manage.views.all_record_types"), selected: params[:record_type] %>
  <%= form.submit t("manage.filter"), class: "lbut" %><%= link_to t("manage.clear"), manage_audit_events_path, class: "lbut" %>
<% end %>
<div class="nl-manage-table-wrap"><table class="nl-manage-table">
  <thead><tr><th><%= t("manage.views.col_time") %></th><th><%= t("manage.views.col_admin") %></th><th><%= t("manage.views.col_action") %></th><th><%= t("manage.views.col_record_type") %></th><th><%= t("manage.views.col_record") %></th><th><%= t("manage.views.col_details") %></th></tr></thead>
  <tbody>
    <% @audit_events.each do |event| %>
      <tr><td><%= l(event.created_at, format: :long) %></td><td><%= event.actor.profile_name %></td><td><%= event.action %></td><td><%= event.record_type %></td><td><%= event.record_label %></td><td><%= link_to t("manage.view"), manage_audit_event_path(event) %></td></tr>
    <% end %>
    <% if @audit_events.empty? %><tr><td colspan="6" class="nl-manage-empty">No audit events found.</td></tr><% end %>
  </tbody>
</table></div>
<%= render "manage/shared/pagination", pagination: @pagination %>
