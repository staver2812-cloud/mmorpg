<% content_for :title, t("game.quests.title") %>

<section class="nl-quests">
  <header class="nl-quests__header">
    <h1><%= t("game.quests.title") %></h1>
    <p><%= t("game.quests.hint") %></p>
    <% if Game::World::CityBuildingCatalog.accessible?(character: current_character, building_key: "city_hall") %>
      <p class="nl-quests-board__meta" data-quest-hall-link="1">
        <%= link_to t("game.quests.board_open_hall"), city_building_path("city_hall"), class: "nl-sheet-link" %>
      </p>
    <% end %>
    <% counts = @entries.group_by { |e| e[:status] }.transform_values(&:size) %>
    <ul class="nl-quests__summary"
        aria-label="<%= t("game.quests.summary_aria") %>"
        data-quest-summary="1"
        data-quest-available="<%= counts.fetch("available", 0) %>"
        data-quest-active="<%= counts.fetch("active", 0) %>"
        data-quest-ready-count="<%= @entries.count { |e| e[:status] == "active" && e[:progress].to_i >= e[:target].to_i } %>"
        data-quest-locked="<%= counts.fetch("locked", 0) %>"
        data-quest-completed="<%= counts.fetch("completed", 0) %>">
      <li><span><%= t("game.quests.status.available") %></span> <b><%= counts.fetch("available", 0) %></b></li>
      <li><span><%= t("game.quests.status.active") %></span> <b><%= counts.fetch("active", 0) %></b></li>
      <li><span><%= t("game.quests.status.locked") %></span> <b><%= counts.fetch("locked", 0) %></b></li>
      <li><span><%= t("game.quests.status.completed") %></span> <b><%= counts.fetch("completed", 0) %></b></li>
    </ul>
  </header>

  <div class="nl-quests__list">
    <% @entries.each do |entry| %>
      <% quest = entry[:quest] %>
      <% title = I18n.locale.to_s.start_with?("ru") ? quest["title_ru"] : quest["title_en"] %>
      <% summary = I18n.locale.to_s.start_with?("ru") ? quest["summary_ru"] : quest["summary_en"] %>
      <% reward = quest.fetch("reward", {}) %>
      <% objective = quest.fetch("objective", {}) %>
      <% ready = entry[:status] == "active" && entry[:progress].to_i >= entry[:target].to_i %>
      <article class="nl-quests__card nl-quests__card--<%= entry[:status] %><%= ' nl-quests__card--ready' if ready %>"
               data-quest-key="<%= quest["key"] %>"
               data-quest-status="<%= entry[:status] %>"
               data-quest-progress="<%= entry[:progress] %>"
               data-quest-target="<%= entry[:target] %>"
               data-quest-ready="<%= ready ? "1" : "0" %>">
        <div class="nl-quests__card-top">
          <h2><%= title %></h2>
          <span class="nl-quests__badge nl-quests__badge--<%= entry[:status] %>">
            <%= ready ? t("game.quests.status.ready") : t("game.quests.status.#{entry[:status]}") %>
          </span>
        </div>
        <p class="nl-quests__giver"><%= t("game.quests.giver", name: quest["giver"]) %></p>
        <% if entry[:where].present? %>
          <p class="nl-quests-board__meta"><%= t("game.quests.where", place: entry[:where]) %></p>
        <% end %>
        <p><%= summary %></p>
        <div class="nl-quests__formula">
          <strong><%= t("game.quests.objective_label") %></strong>
          <span>
            <%= t("game.quests.objective_#{objective["type"]}", default: objective["type"].to_s) %>
            · <%= entry[:progress] %> / <%= entry[:target] %>
          </span>
        </div>
        <ul class="nl-quests__rewards">
          <% if reward["experience"].to_i.positive? %>
            <li class="nl-quests__chip"><%= t("game.quests.reward_xp", amount: reward["experience"]) %></li>
          <% end %>
          <% if reward["currency_nv"].to_i.positive? %>
            <li class="nl-quests__chip"><%= t("game.quests.reward_nv", amount: reward["currency_nv"]) %></li>
          <% end %>
          <% if reward["item_key"].present? %>
            <% item_name = ItemTemplate.find_by(key: reward["item_key"])&.display_name || reward["item_key"] %>
            <li class="nl-quests__chip"><%= t("game.quests.reward_item", key: item_name) %></li>
          <% end %>
        </ul>
        <div class="nl-quests__actions">
          <% if entry[:status] == "available" %>
            <%= button_to t("game.quests.accept"), accept_quest_path(quest["key"]), method: :post, class: "lbut" %>
          <% elsif entry[:status] == "active" && ready %>
            <%= button_to t("game.quests.turn_in"), turn_in_quest_path(quest["key"]), method: :post, class: "lbut" %>
          <% elsif entry[:status] == "active" %>
            <button type="button" class="lbut" disabled title="<%= t("game.quests.objective_incomplete") %>"><%= t("game.quests.turn_in") %></button>
            <span class="nl-quests__done">
              <%= t("game.quests.objective_incomplete") %>
              <%= link_to t("game.quests.continue_world"), world_path, class: "nl-sheet-link", data: {quest_recovery: "world"} %>
            </span>
          <% elsif entry[:status] == "locked" %>
            <span class="nl-quests__done"><%= t("game.quests.locked_hint") %></span>
          <% else %>
            <span class="nl-quests__done"><%= t("game.quests.done") %></span>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>
</section>
