<% content_for :title, t("game.quests.title") %>

<section class="nl-quests">
  <header class="nl-quests__header">
    <h1><%= t("game.quests.title") %></h1>
    <p><%= t("game.quests.hint") %></p>
    <% counts = @entries.group_by { |e| e[:status] }.transform_values(&:size) %>
    <ul class="nl-quests__summary" aria-label="<%= t("game.quests.summary_aria") %>">
      <li><span><%= t("game.quests.status.available") %></span> <b><%= counts.fetch("available", 0) %></b></li>
      <li><span><%= t("game.quests.status.active") %></span> <b><%= counts.fetch("active", 0) %></b></li>
      <li><span><%= t("game.quests.status.completed") %></span> <b><%= counts.fetch("completed", 0) %></b></li>
    </ul>
  </header>

  <div class="nl-quests__list">
    <% @entries.each do |entry| %>
      <% quest = entry[:quest] %>
      <% title = I18n.locale.to_s.start_with?("ru") ? quest["title_ru"] : quest["title_en"] %>
      <% summary = I18n.locale.to_s.start_with?("ru") ? quest["summary_ru"] : quest["summary_en"] %>
      <% reward = quest.fetch("reward", {}) %>
      <% objective = quest.fetch("objective", {}) %>
      <article class="nl-quests__card nl-quests__card--<%= entry[:status] %>">
        <div class="nl-quests__card-top">
          <h2><%= title %></h2>
          <span class="nl-quests__badge nl-quests__badge--<%= entry[:status] %>">
            <%= t("game.quests.status.#{entry[:status]}") %>
          </span>
        </div>
        <p class="nl-quests__giver"><%= t("game.quests.giver", name: quest["giver"]) %></p>
        <p><%= summary %></p>
        <div class="nl-quests__formula">
          <strong><%= t("game.quests.objective_label") %></strong>
          <span>
            <%= t("game.quests.objective_#{objective["type"]}", default: objective["type"].to_s) %>
            · <%= entry[:progress] %> / <%= entry[:target] %>
          </span>
        </div>
        <ul class="nl-quests__rewards">
          <% if reward["experience"].to_i.positive? %>
            <li class="nl-quests__chip"><%= t("game.quests.reward_xp", amount: reward["experience"]) %></li>
          <% end %>
          <% if reward["currency_nv"].to_i.positive? %>
            <li class="nl-quests__chip"><%= t("game.quests.reward_nv", amount: reward["currency_nv"]) %></li>
          <% end %>
          <% if reward["item_key"].present? %>
            <li class="nl-quests__chip"><%= t("game.quests.reward_item", key: reward["item_key"]) %></li>
          <% end %>
        </ul>
        <div class="nl-quests__actions">
          <% if entry[:status] == "available" %>
            <%= button_to t("game.quests.accept"), accept_quest_path(quest["key"]), method: :post, class: "lbut" %>
          <% elsif entry[:status] == "active" %>
            <%= button_to t("game.quests.turn_in"), turn_in_quest_path(quest["key"]), method: :post, class: "lbut" %>
          <% else %>
            <span class="nl-quests__done"><%= t("game.quests.done") %></span>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>
</section>
