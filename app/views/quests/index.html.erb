<% content_for :title, t("game.quests.title") %>

<section class="nl-quests">
  <header class="nl-quests__header">
    <h1><%= t("game.quests.title") %></h1>
    <p><%= t("game.quests.hint") %></p>
  </header>

  <div class="nl-quests__list">
    <% @entries.each do |entry| %>
      <% quest = entry[:quest] %>
      <% title = I18n.locale.to_s.start_with?("ru") ? quest["title_ru"] : quest["title_en"] %>
      <% summary = I18n.locale.to_s.start_with?("ru") ? quest["summary_ru"] : quest["summary_en"] %>
      <article class="nl-quests__card nl-quests__card--<%= entry[:status] %>">
        <h2><%= title %></h2>
        <p class="nl-quests__giver"><%= t("game.quests.giver", name: quest["giver"]) %></p>
        <p><%= summary %></p>
        <p class="nl-quests__progress">
          <%= t("game.quests.status.#{entry[:status]}") %>
          <% if entry[:status] == "active" || entry[:status] == "completed" %>
            — <%= entry[:progress] %> / <%= entry[:target] %>
          <% end %>
        </p>
        <div class="nl-quests__actions">
          <% if entry[:status] == "available" %>
            <%= button_to t("game.quests.accept"), accept_quest_path(quest["key"]), method: :post, class: "lbut" %>
          <% elsif entry[:status] == "active" %>
            <%= button_to t("game.quests.turn_in"), turn_in_quest_path(quest["key"]), method: :post, class: "lbut" %>
          <% else %>
            <span class="nl-quests__done"><%= t("game.quests.done") %></span>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>
</section>
