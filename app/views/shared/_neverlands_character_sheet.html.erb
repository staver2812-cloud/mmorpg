<%#
  Character sheet shared by the player profile and the inventory page.

  Composition follows the live main-frame capture: a 258px paper doll beside a
  fixed 200px parameter column ordered money, primary stats, save, experience,
  record, increases banner, combat chips, effects.
  See doc/design/reference/neverlands_live_style_system.md.
%>
<% character ||= current_character %>
<% equipment ||= {} %>
<% interactive = local_assigns.fetch(:interactive, false) %>
<% show_money = local_assigns.fetch(:show_money, true) %>
<% metadata = character.metadata.to_h %>
<% fatigue = profile_fatigue(character) %>

<section class="nl-character-sheet" aria-label="<%= t("game.sheet.aria_label", name: character.name) %>">
  <div class="nl-character-doll-column">
    <%= render "shared/equipment_paperdoll",
      character: character,
      equipment: equipment,
      interactive: interactive,
      category: local_assigns[:category],
      subcategory: local_assigns[:subcategory],
      info_mode: local_assigns[:info_mode] %>
  </div>

  <div class="nl-character-parameters">
    <% if show_money %>
      <table class="nl-sheet-table nl-sheet-table--money">
        <tbody>
          <tr>
            <th><span class="nl-money-mark" aria-hidden="true">NV</span> <%= t("game.sheet.money") %>:</th>
            <td class="nl-sheet-nv" data-sheet-nv="<%= character.user&.currency_wallet&.nv_balance.to_i %>">
              <%= number_with_delimiter(character.user&.currency_wallet&.nv_balance || 0) %> NV
              <% if character == current_character && character.user&.currency_wallet&.nv_balance.to_i <= 0 %>
                ·
                <% if Game::World::CityBuildingCatalog.accessible?(character:, building_key: "junk_dealer") %>
                  <%= link_to t("game.buildings.junk_dealer_link"), city_building_path("junk_dealer"), class: "nl-sheet-link", data: {sheet_recovery: "junk"} %>
                <% elsif Game::World::CityBuildingCatalog.accessible?(character:, building_key: "shop") %>
                  <%= link_to t("game.shop.modes.sell"), shop_path(mode: "sell"), class: "nl-sheet-link", data: {sheet_recovery: "shop"} %>
                <% else %>
                  <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {sheet_recovery: "world"} %>
                <% end %>
              <% end %>
            </td>
          </tr>
          <% if character == current_character %>
            <tr>
              <th><span class="nl-money-mark" aria-hidden="true">VM</span> <%= t("game.sheet.veil_marks") %>:</th>
              <td class="nl-sheet-vm" data-sheet-vm="<%= character.user&.currency_wallet&.veil_marks.to_i %>">
                <%= number_with_delimiter(character.user&.currency_wallet&.veil_marks.to_i) %> VM
                <% if Game::World::CityBuildingCatalog.accessible?(character:, building_key: "hospital") %>
                  · <%= link_to t("game.sheet.veil_marks_open_cta"), city_building_path("hospital"), class: "nl-sheet-link" %>
                <% elsif character == current_character %>
                  · <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {sheet_recovery: "world"} %>
                <% end %>
              </td>
            </tr>
            <% vault_nv = Game::World::BankVault.balance_for(character) %>
            <tr>
              <th><%= t("game.sheet.vault") %>:</th>
              <td class="nl-sheet-vault" data-sheet-vault="<%= vault_nv %>">
                <%= number_with_delimiter(vault_nv) %> NV
                <% if Game::World::CityBuildingCatalog.accessible?(character:, building_key: "bank") %>
                  · <%= link_to t("game.sheet.vault_open_cta"), city_building_path("bank"), class: "nl-sheet-link" %>
                <% elsif character == current_character %>
                  · <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {sheet_recovery: "world"} %>
                <% end %>
              </td>
            </tr>
            <% stored = Game::World::BankItemLocker.stored_for(character) %>
            <tr>
              <th><%= t("game.sheet.locker") %>:</th>
              <td class="nl-sheet-locker" data-sheet-locker="<%= stored.present? ? "occupied" : "empty" %>">
                <% if stored.present? %>
                  <%= t("game.sheet.locker_occupied", name: stored["name"], qty: stored["quantity"]) %>
                <% else %>
                  <%= t("game.sheet.locker_empty") %>
                  <% if Game::World::CityBuildingCatalog.accessible?(character:, building_key: "bank") %>
                    · <%= link_to t("game.sheet.vault_open_cta"), city_building_path("bank"), class: "nl-sheet-link", data: {sheet_recovery: "bank"} %>
                  <% else %>
                    · <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {sheet_recovery: "world"} %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>

    <table class="nl-sheet-table nl-sheet-table--stats">
      <caption class="nl-visually-hidden"><%= t("game.sheet.primary_stats") %></caption>
      <tbody>
        <% profile_primary_stats(character).each do |stat| %>
          <tr>
            <th><%= stat[:label] %>:</th>
            <td class="nl-sheet-stat-total"><%= stat[:total] %></td>
            <td class="nl-sheet-stat-breakdown">
              <% if stat[:equipment] != 0 %>
                (<%= stat[:base] %>+<span class="nl-sheet-bonus"><%= stat[:equipment] %></span>)
              <% end %>
            </td>
          </tr>
        <% end %>
        <tr>
          <th><%= t("game.sheet.wisdom") %>:</th>
          <td class="nl-sheet-stat-total"><%= metadata.fetch("wisdom", 0) %></td>
          <td class="nl-sheet-stat-breakdown"></td>
        </tr>
      </tbody>
    </table>

    <div class="nl-sheet-link-row"><%= link_to t("game.common.save"), player_path(name: character.name) %></div>

    <hr class="nl-sheet-divider">

    <table class="nl-sheet-table nl-sheet-table--experience">
      <caption><%= t("game.sheet.experience") %></caption>
      <tbody>
        <tr><th><%= t("game.sheet.combat_xp") %>:</th><td class="nl-sheet-xp-combat"><%= number_with_delimiter(character.experience) %></td></tr>
        <tr><th><%= t("game.sheet.glory") %>:</th><td class="nl-sheet-xp-glory"><%= number_with_delimiter(metadata.fetch("glory", 0)) %></td></tr>
        <tr><th><%= t("game.sheet.valor") %>:</th><td class="nl-sheet-xp-valor"><%= number_with_delimiter(metadata.fetch("valor", 0)) %></td></tr>
        <tr><th><%= t("game.sheet.to_level") %>:</th><td><%= number_with_delimiter(character.experience_to_next_level) %></td></tr>
      </tbody>
    </table>

    <hr class="nl-sheet-divider">

    <table class="nl-sheet-table nl-sheet-table--record">
      <caption class="nl-visually-hidden"><%= t("game.sheet.fight_record") %></caption>
      <tbody>
        <tr><th><%= t("game.sheet.wins") %>:</th><td><%= metadata.fetch("player_wins", 0) %></td></tr>
        <tr><th><%= t("game.sheet.losses") %>:</th><td><%= metadata.fetch("player_losses", 0) %></td></tr>
        <tr><th><%= t("game.sheet.wins_npc") %>:</th><td><%= metadata.fetch("npc_wins", 0) %></td></tr>
        <tr><th><%= t("game.sheet.losses_npc") %>:</th><td><%= metadata.fetch("npc_losses", 0) %></td></tr>
      </tbody>
    </table>

    <div class="nl-sheet-increases" data-sheet-increases="<%= character.stat_points_available.to_i %>">
      <%= t("game.sheet.increases") %>: <%= character.stat_points_available.to_i %>
      <% if character == current_character && character.stat_points_available.to_i <= 0 %>
        ·
        <%= link_to t("nav.world"), world_path, class: "nl-sheet-link", data: {sheet_recovery: "world"} %>
      <% end %>
    </div>

    <table class="nl-sheet-table nl-sheet-table--chips">
      <caption class="nl-visually-hidden"><%= t("game.sheet.combat_params") %></caption>
      <tbody>
        <tr>
          <th><%= t("game.sheet.fatigue") %>:</th>
          <td class="nl-sheet-chip nl-sheet-chip--fatigue"><%= fatigue %>%</td>
        </tr>
        <tr>
          <th><%= t("game.sheet.alignment") %>:</th>
          <td class="nl-sheet-chip">
            <%= t("game.buildings.law_alignment.#{character.alignment}") %>
            <% if character == current_character %>
              <% if Game::World::CityBuildingCatalog.accessible?(character:, building_key: "law_abode") %>
                · <%= link_to t("game.buildings.law_open_cta"), city_building_path("law_abode"), class: "nl-sheet-link", data: {sheet_recovery: "law"} %>
              <% elsif character.alignment.to_s == "none" %>
                · <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {sheet_recovery: "world"} %>
              <% end %>
            <% end %>
          </td>
        </tr>
        <% profile_combat_stats(character).each do |label, value| %>
          <tr>
            <th><%= label %>:</th>
            <td class="nl-sheet-chip"><%= value %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <p class="nl-sheet-effects"><%= t("game.sheet.total_effects") %>: <%= metadata.fetch("active_effects", []).size %> / 99</p>
    <% post_note = Game::World::PostOfficeNote.current_for(character) %>
    <% if post_note.present? %>
      <p class="nl-sheet-effects" title="<%= t("game.sheet.post_note_hint") %>">
        <%= t("game.sheet.post_note") %>: <%= truncate(post_note, length: 80) %>
      </p>
    <% end %>
  </div>
</section>
