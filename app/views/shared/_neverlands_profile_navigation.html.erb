<% current_section ||= nil %>

<nav class="nl-profile-tabs" aria-label="<%= t("game.profile.sections") %>">
  <% if current_section.nil? %>
    <span class="lbutdis" aria-current="page"><%= t("game.profile.overview") %></span>
  <% else %>
    <%= link_to t("game.profile.overview"), player_path(name: character.name), class: "lbut" %>
  <% end %>
  <% if current_section == :skills %>
    <span class="lbutdis" aria-current="page"><%= t("game.profile.skills") %></span>
  <% else %>
    <%= link_to t("game.profile.skills"), skills_character_path(character), class: "lbut" %>
  <% end %>
  <% if current_section == :perks %>
    <span class="lbutdis" aria-current="page"><%= t("game.profile.perks") %></span>
  <% else %>
    <%= link_to t("game.profile.perks"), perks_character_path(character), class: "lbut" %>
  <% end %>
  <% if current_section == :licenses %>
    <span class="lbutdis" aria-current="page"><%= t("game.common.licenses") %></span>
  <% else %>
    <%= link_to t("game.common.licenses"), character_licenses_path, class: "lbut" %>
  <% end %>
</nav>
