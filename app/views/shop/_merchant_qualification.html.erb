<% qualification = Game::Shop::MerchantQualification.new(character: current_character) %>
<% if qualification.visible_at?(location) %>
  <section class="nl-panel" aria-label="<%= t("game.shop.merchant_title") %>">
    <h2><%= t("game.shop.merchant_title") %></h2>
    <% case qualification.status %>
    <% when "completed" %>
      <p class="nl-empty-note"><%= t("game.shop.merchant_done") %></p>
    <% when "not_started" %>
      <% if location == :market %>
        <p class="nl-empty-note"><%= t("game.shop.merchant_accept") %></p>
        <%= button_to t("game.shop.merchant_accept_btn"), accept_merchant_qualification_path, class: "lbut" %>
      <% else %>
        <p class="nl-empty-note"><%= t("game.shop.merchant_market_first") %></p>
      <% end %>
    <% when "accepted" %>
      <% if location == :shop %>
        <p class="nl-empty-note"><%= t("game.shop.merchant_collect_market") %></p>
        <%= button_to t("game.shop.merchant_pay_btn"), pay_merchant_qualification_path, class: "lbut" %>
      <% else %>
        <p class="nl-empty-note"><%= t("game.shop.merchant_collect_shop") %></p>
      <% end %>
    <% when "paid" %>
      <% if location == :market %>
        <p class="nl-empty-note"><%= t("game.shop.merchant_receipt_ready") %></p>
        <%= button_to t("game.shop.merchant_complete_btn"), complete_merchant_qualification_path, class: "lbut" %>
      <% else %>
        <p class="nl-empty-note"><%= t("game.shop.merchant_receipt_done") %></p>
      <% end %>
    <% else %>
      <p class="nl-empty-note"><%= t("game.shop.merchant_unavailable") %></p>
    <% end %>
  </section>
<% end %>
