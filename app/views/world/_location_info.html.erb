<div class="location-info-panel">
  <h3><%= t("game.world.location") %></h3>

  <div class="location-description">
    <p><strong><%= location_label %></strong> [<%= position.x %>, <%= position.y %>]</p>
  </div>
  <% if params[:shop_denied].to_s == "1" %>
    <p class="nl-quests-board__meta" data-shop-denied="1">
      <%= t("game.shop.denied_next") %>
      ·
      <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {shop_recovery: "world"} %>
    </p>
  <% end %>
</div>
