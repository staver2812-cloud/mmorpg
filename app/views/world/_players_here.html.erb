<div class="players-panel">
  <h3><%= t("game.world.players_here") %></h3>
  <% if players.any? %>
    <ul class="players-list">
      <% players.each do |pos| %>
        <li class="player-item">
          <span class="player-avatar">&gt;</span>
          <div class="player-info">
            <span class="player-name"><%= pos.character.name %></span>
            <span class="player-level">[<%= pos.character.level %>]</span>
          </div>
          <div class="player-actions">
            <%= link_to t("game.common.info"), player_path(name: pos.character.name), title: t("nav.your_character") %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-muted text-sm"><%= t("game.world.no_players") %></p>
  <% end %>
</div>
